# Copie para .env e ajuste valores

# SEGURANÇA — OBRIGATÓRIO
# Gere um segredo forte: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=ALTERE-PARA-UM-SEGREDO-FORTE-GERADO-ALEATORIAMENTE
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# Banco de dados
# Dev: SQLite local
DATABASE_URL=sqlite:///./mindtrack.db
# Produção: PostgreSQL
# DATABASE_URL=postgresql://usuario:senha@localhost:5432/mindtrack

# API
API_TITLE=MindTrack API
API_VERSION=1.0.0
DEBUG=false

# CORS — origens permitidas separadas por vírgula
CORS_ORIGINS=http://127.0.0.1:8081,http://127.0.0.1:8082,http://127.0.0.1:8083,http://localhost:8081,http://localhost:8082,http://localhost:8083,http://10.4.0.205:8081,http://10.4.0.205:8082,http://10.4.0.205:8083,http://localhost:19006,exp://localhost:19000
